// UNI-PAY Prisma Schema — Phase 4 + Phase 6 + Phase 8
// Conçu pour SQLite en local/MVP, 100% portable vers PostgreSQL pour la production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Phase 4 : Employee Management ──────────────────────────────────────────────

model Employee {
  id               String    @id @default(cuid())
  matricule        String    @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  gender           String?   // M, F
  nationalId       String?   // CIN
  status           String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  // Informations administratives
  grade            String?   // Grade fonctionnel (ex: MC-A, B, Administrateur)
  position         String?   // Poste/Fonction
  category         String?   // Permanent, Contractuel, Vacataire
  recruitmentDate  DateTime?
  // Informations salariales
  baseSalary       Decimal   @default(0) // Salaire de base en DZD
  index            Int?      // Indice de traitement
  // Informations bancaires
  rib              String?   // Relevé d'Identité Bancaire
  bankName         String?   // Nom de la banque
  // Contacts
  phone            String?
  email            String?
  address          String?
  // Relations
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  organizationUnitId String?
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  createdBy        String?   // userId de l'agent
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  history          EmployeeHistory[]
  payrollRecords   PayrollRecord[]
  batchEntries     BatchEmployee[]
  attendanceRecords AttendanceRecord[]
  lineItems        PayrollLineItem[]
  auditFindings    AuditFinding[]
  user             User?
  paymentTransactions PaymentTransaction[]

  @@index([organizationId])
  @@index([organizationUnitId])
  @@index([status])
  @@index([grade])
  @@map("employees")
}

model EmployeeHistory {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  field       String   // Le champ modifié (ex: "baseSalary", "grade", "status")
  oldValue    String?
  newValue    String
  changedBy   String   // userId
  reason      String?  // Motif de la modification
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([field])
  @@map("employee_history")
}

// ── Phase 4 : Payroll Period ────────────────────────────────────────────────────

model PayrollPeriod {
  id          String   @id @default(cuid())
  year        Int
  month       Int      // 1-12
  label       String   // "Octobre 2026"
  status      String   @default("DRAFT") // DRAFT, OPEN, PROCESSING, CLOSED
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches PayrollBatch[]

  @@unique([year, month])
  @@index([status])
  @@map("payroll_periods")
}

// ── Phase 4 : Payroll Batch ────────────────────────────────────────────────────

model PayrollBatch {
  id             String        @id @default(cuid())
  periodId       String
  period         PayrollPeriod @relation(fields: [periodId], references: [id])
  versionNumber  Int           @default(1) // v1, v2 si correction
  label          String?       // Libellé optionnel
  // Statuts complets du workflow — centralisés dans lib/workflow/states.ts
  // DRAFT | CALCULATING | CALCULATED | AUDITING | READY_FOR_REVIEW
  // CHEF_REVIEW | APPROVED_BY_CHEF | DIRECTOR_REVIEW | APPROVED_BY_DIRECTOR
  // ACCOUNTING_REVIEW | ACCOUNTING_VALIDATED | FINANCIAL_CONTROL | AUTHORIZED
  // PAYMENT_PROCESSING | PAID | CLOSED | RETURNED_FOR_CORRECTION
  status         String        @default("DRAFT")
  notes          String?
  calculatedAt   DateTime?
  // Périmètre organisationnel — hérité du créateur du batch
  organizationId String?       // nullable pour compatibilité rétroactive
  organization   Organization? @relation(fields: [organizationId], references: [id])
  submittedBy    String?       // userId qui a soumis au workflow
  submittedAt    DateTime?
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employees         BatchEmployee[]
  records           PayrollRecord[]
  attendanceRecords AttendanceRecord[]
  lineItems         PayrollLineItem[]
  auditFindings     AuditFinding[]
  workflowActions   WorkflowAction[]
  paymentOrder      PaymentOrder?

  @@unique([periodId, versionNumber])
  @@index([periodId])
  @@index([status])
  @@index([organizationId])
  @@map("payroll_batches")
}

// Association Batch <-> Employee (sans doublon par batch)
model BatchEmployee {
  id         String       @id @default(cuid())
  batchId    String
  batch      PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id])
  addedBy    String?
  addedAt    DateTime     @default(now())

  @@unique([batchId, employeeId])
  @@index([batchId])
  @@index([employeeId])
  @@map("batch_employees")
}

// ── Phase 4 : Payroll Record (snapshot figé au moment du calcul) ───────────────

model PayrollRecord {
  id              String       @id @default(cuid())
  batchId         String
  batch           PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id])
  // Snapshot des données employé au moment du calcul
  snapshotMatricule String
  snapshotName    String
  snapshotGrade   String?
  snapshotBaseSalary Decimal
  // Résultats du calcul
  grossAmount     Decimal      @default(0)   // Salaire brut
  totalAllowances Decimal      @default(0)   // Total indemnités
  totalDeductions Decimal      @default(0)   // Total retenues
  totalContributions Decimal   @default(0)   // Cotisations sociales (CNAS, etc.)
  totalTaxes      Decimal      @default(0)   // IRG
  netAmount       Decimal      @default(0)   // Salaire net
  // Métadonnées de calcul
  calculationMeta String?      // JSON des règles utilisées (PayrollRule codes + versions)
  status          String       @default("CALCULATED") // CALCULATED, ERROR
  errorMessage    String?
  calculatedAt    DateTime     @default(now())

  paymentTransaction PaymentTransaction?

  @@unique([batchId, employeeId])
  @@index([batchId])
  @@index([employeeId])
  @@map("payroll_records")
}

// ── Phase 4 : Attendance (Présences / Absences) ────────────────────────────────

model AttendanceRecord {
  id             String       @id @default(cuid())
  batchId        String
  batch          PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  workingDays    Int          @default(30) // Jours de travail du mois
  presentDays    Decimal      @default(30) // Jours effectivement présents
  absentDays     Decimal      @default(0)  // Jours d'absence non justifiée
  sickDays       Decimal      @default(0)  // Congé maladie
  vacationDays   Decimal      @default(0)  // Congé annuel
  lateMinutes    Int          @default(0)  // Retards en minutes
  notes          String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([batchId, employeeId])
  @@index([batchId])
  @@index([employeeId])
  @@map("attendance_records")
}

// ── Phase 4 : PayrollLineItem (Indemnités & Retenues) ─────────────────────────

model PayrollLineItem {
  id          String       @id @default(cuid())
  batchId     String
  batch       PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id])
  type        String       // ALLOWANCE, BONUS, DEDUCTION, CONTRIBUTION, TAX
  code        String?      // Référence à une PayrollRule (optionnel)
  labelAr     String       // Libellé en arabe
  amount      Decimal      // Montant en DZD (positif)
  isManual    Boolean      @default(true) // true = saisi manuellement, false = calculé par le moteur
  sourceRule  String?      // Code PayrollRule si calculé
  notes       String?
  createdBy   String?
  createdAt   DateTime     @default(now())

  @@index([batchId])
  @@index([employeeId])
  @@index([type])
  @@map("payroll_line_items")
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  status          String   @default("ACTIVE") // PENDING, ACTIVE, SUSPENDED, ARCHIVED
  address         String?
  wilaya          String?
  phone           String?
  email           String?
  website         String?
  description     String?
  isActive        Boolean  @default(true)
  suspendedAt     DateTime?
  suspendedReason String?
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users              User[]
  units              OrganizationUnit[]
  employees          Employee[]
  batches            PayrollBatch[]
  auditLogs          AuditLog[]
  universitySettings UniversitySetting[]

  @@map("organizations")
}

model OrganizationUnit {
  id             String             @id @default(cuid())
  name           String
  code           String             @unique
  type           String // PRESIDENCY, FACULTY, DIRECTION, SERVICE, DEPARTMENT, SECRETARIAT_GENERAL, OTHER
  parentId       String?
  parent         OrganizationUnit?  @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       OrganizationUnit[] @relation("UnitHierarchy")
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  employees Employee[]

  @@index([organizationId])
  @@index([parentId])
  @@map("organization_units")
}

model UniversitySetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          String
  category       String       @default("GENERAL") // GENERAL, PAYROLL, INTERFACE, NOTIFICATION
  labelAr        String
  descriptionAr  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("university_settings")
}

model SystemSetting {
  id            String   @id @default(cuid())
  key           String   @unique
  value         String
  category      String // GENERAL, SECURITY, INTERFACE, SYSTEM
  labelAr       String
  descriptionAr String?
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@map("system_settings")
}

model PayrollRule {
  id            String   @id @default(cuid())
  code          String   @unique // Identifiant technique de la règle (ex: CNAS_SALARIAL, IEP_ECHELON)
  nameAr        String
  descriptionAr String?
  category      String // TAX, SOCIAL_CONTRIBUTION, ALLOWANCE, BONUS, BASE_INDEX
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions PayrollRuleVersion[]

  @@index([category])
  @@map("payroll_rules")
}

model PayrollRuleVersion {
  id            String      @id @default(cuid())
  ruleId        String
  rule          PayrollRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  versionNumber Int
  value         String // Valeur ou paramètres (ex: "0.09" pour 9%, ou barème JSON)
  unit          String // PERCENTAGE, FIXED_AMOUNT, INDEX_POINTS, COEFFICIENT, FORMULA
  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?
  createdBy     String?
  createdAt     DateTime    @default(now())

  @@unique([ruleId, versionNumber])
  @@index([ruleId])
  @@index([effectiveFrom])
  @@map("payroll_rule_versions")
}

model Role {
  id            String   @id @default(cuid())
  code          String   @unique // ADMIN, AGENT_RH, CHEF_SERVICE, DIRECTEUR, COMPTABLE, CONTROLEUR_FINANCIER, EMPLOYE
  nameAr        String
  descriptionAr String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  code      String   @unique // users.read, payroll.prepare, etc.
  nameAr    String
  category  String
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  roleId         String
  role           Role          @relation(fields: [roleId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  isActive       Boolean       @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employeeId       String?          @unique
  employee         Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  sessions         Session[]
  auditLogs        AuditLog[]
  resolvedFindings AuditFinding[]
  workflowActions  WorkflowAction[]
  notifications    Notification[]
  paymentOrdersCreated   PaymentOrder[] @relation("PaymentOrderCreator")
  paymentOrdersConfirmed PaymentOrder[] @relation("PaymentOrderConfirmer")

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model AuditLog {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String // LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, SESSION_REVOKED
  resourceType   String?
  resourceId     String?
  details        String? // JSON metadata / descriptions
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([organizationId])
  @@map("audit_logs")
}

// ── Phase 5 : Smart Audit & AI ────────────────────────────────────────────────

model AuditFinding {
  id             String        @id @default(cuid())
  batchId        String
  batch          PayrollBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  type           String        // SALARY_VARIATION, DUPLICATE_EMPLOYEE, MISSING_DATA, INVALID_VALUE, ATTENDANCE_ANOMALY, ALLOWANCE_ANOMALY, DEDUCTION_ANOMALY, PAYROLL_TOTAL_VARIATION, RIB_DATA_ANOMALY, OTHER
  severity       String        // INFO, WARNING, HIGH, CRITICAL
  title          String
  description    String
  detectedValue  String?
  expectedValue  String?
  status         String        @default("OPEN") // OPEN, REVIEWED, CONFIRMED, FALSE_POSITIVE, RESOLVED
  source         String        @default("RULE_ENGINE") // RULE_ENGINE, AI_ASSISTANT
  confidence     Float?        // Indice de confiance (0.0 à 1.0)
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?       // userId du réviseur
  resolvedByUser User?         @relation(fields: [resolvedBy], references: [id], onDelete: SetNull)
  resolutionNote String?

  aiAnalyses     AIAnalysis[]

  @@index([batchId])
  @@index([employeeId])
  @@index([status])
  @@index([severity])
  @@index([type])
  @@map("audit_findings")
}

model AIAnalysis {
  id             String       @id @default(cuid())
  findingId      String
  finding        AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  model          String       // ex: gemini-2.5-flash
  analysis       String       // Explication détaillée
  recommendation String       // Proposition d'action humaine
  confidence     Float        // 0.0 à 1.0
  possibleCauses String?      // JSON sérialisé des causes possibles
  dataConsidered String?      // JSON des métadonnées contextuelles analysées
  createdAt      DateTime     @default(now())

  @@index([findingId])
  @@map("ai_analyses")
}

// ── Phase 6 : Workflow d'approbation multi-niveaux ────────────────────────────

/// Trace chaque transition dans le workflow institutionnel de paie.
/// Immuable — ne jamais supprimer un WorkflowAction.
model WorkflowAction {
  id         String       @id @default(cuid())
  batchId    String
  batch      PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String       // SUBMIT_TO_CHEF | TAKE_CHEF_REVIEW | APPROVE_CHEF | RETURN_BY_CHEF | ...
  fromStatus String       // Statut avant la transition
  toStatus   String       // Statut après la transition
  reason     String?      // Obligatoire pour les retours (RETURN_BY_*)
  metadata   String?      // JSON safe — jamais de secrets
  createdAt  DateTime     @default(now())

  @@index([batchId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
  @@map("workflow_actions")
}

/// Notifications système liées aux transitions workflow.
/// Un utilisateur ne peut voir et modifier que ses propres notifications.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // BATCH_SUBMITTED | BATCH_APPROVED | BATCH_RETURNED | PAYMENT_AUTHORIZED
  titleAr   String
  messageAr String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ── Phase 8 : Paiement • Ordres de Paiement • Clôture ──────────────────────────

/// Ordre de paiement institutionnel lié à un PayrollBatch AUTHORIZED.
/// Immuable une fois CLOSED. Source de vérité opérationnelle du processus de paiement.
model PaymentOrder {
  id                   String               @id @default(cuid())
  /// Référence unique lisible — ex: OP-202610-A1B2C3D4
  reference            String               @unique
  batchId              String               @unique
  batch                PayrollBatch         @relation(fields: [batchId], references: [id])
  /// PREPARED | PROCESSING | PAID | RECONCILED | CLOSED | FAILED
  status               String               @default("PREPARED")
  totalAmount          Decimal
  employeeCount        Int
  currency             String               @default("DZD")
  /// GENERIC_BANK_TRANSFER (toujours — aucun format bancaire officiel prétendu)
  bankFormat           String               @default("GENERIC_BANK_TRANSFER")
  fileName             String?
  fileHash             String?              // SHA-256 hex digest du contenu du fichier
  fileSize             Int?                 // taille en octets
  createdById          String?
  createdBy            User?                @relation("PaymentOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedById        String?
  confirmedBy          User?                @relation("PaymentOrderConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  /// MANUAL_CONTROLLED (V1 — aucune banque réelle connectée)
  confirmationMethod   String?              @default("MANUAL_CONTROLLED")
  confirmationRef      String?              // Référence fournie lors de la confirmation
  processingStartedAt  DateTime?
  paidAt               DateTime?
  closedAt             DateTime?
  failureReason        String?
  reconciliationNotes  String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  transactions PaymentTransaction[]

  @@index([status])
  @@index([batchId])
  @@map("payment_orders")
}

/// Transaction de paiement individuelle par employé au sein d'un PaymentOrder.
/// Le RIB complet n'est PAS stocké ici — uniquement les 4 derniers chiffres masqués.
model PaymentTransaction {
  id              String        @id @default(cuid())
  paymentOrderId  String
  paymentOrder    PaymentOrder  @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  payrollRecordId String        @unique
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id])
  /// Référence unique de la transaction — ex: TX-OP-202610-001
  reference       String        @unique
  amount          Decimal
  /// RIB masqué : uniquement les 4 derniers chiffres — jamais le RIB complet
  ribMasked       String
  /// Snapshot immuable des données au moment de l'émission de l'ordre
  snapshotMatricule String?
  snapshotName      String?
  /// RIB complet capturé lors de l'ordre — strictement réservé à la génération serveur du fichier technique
  ribSnapshot       String?
  currency          String        @default("DZD")
  /// PENDING | PAID | FAILED
  status          String        @default("PENDING")
  failureReason   String?
  confirmedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([paymentOrderId])
  @@index([status])
  @@index([employeeId])
  @@map("payment_transactions")
}
